# Copy to .env before starting with Docker Compose.

# Optional. When set, every /api/v1 request must send X-API-Key or
# Authorization: Bearer <key>. Leave empty only on a trusted private network.
API_KEY=

# Polling schedule.
CHECK_INTERVAL_MINUTES=30
SCHEDULER_ENABLED=true
CHECK_ON_START=true

# Every N hours ignore ETag/Last-Modified once and download the full file.
# This guards against an incorrectly configured ETag on the origin server.
# 0 means every check is a full download.
FULL_CHECK_INTERVAL_HOURS=24

# HTTP behaviour.
HTTP_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_BYTES=26214400
USER_AGENT="IDADM-Official-Doc-Monitor/0.1 (low-frequency polling of public PDFs; contact: admin@example.com)"

# Storage and logging. API timestamps are always UTC.
DATA_DIR=/data
LOG_LEVEL=INFO

# Maximum size of generated unified diffs / Markdown reports.
MAX_DIFF_CHARS=250000
